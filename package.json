{
  "name": "@yiyunet/dsh-mcp-client-manager",
  "version": "1.0.4",
  "description": "在 设置 → 侧栏 提供「MCP 客户端」面板：列出/添加/改写/启停 @deepseek-ai/dsh-mcp-client 的 MCP 行；受管行写入自有层 $DSH_HOME/cordis.patch.yml，手写行走官方 configEditor/pluginManager 通道。零构建、零运行依赖。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "mcp-client",
    "settings-panel"
  ],
  "author": {
    "name": "yiyunet",
    "url": "https://github.com/yiyunet"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiyunet/dsh-mcp-client-manager.git"
  },
  "homepage": "https://github.com/yiyunet/dsh-mcp-client-manager#readme",
  "bugs": {
    "url": "https://github.com/yiyunet/dsh-mcp-client-manager/issues"
  },
  "type": "module",
  "exports": {
    ".": "./plugin-src/host/index.mjs",
    "./client": "./plugin-src/client/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "plugin-src",
    "scripts",
    "locale",
    "docs",
    "assets",
    "CONTEXT.md",
    "cordis.patch.yml",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test test/validate.test.mjs test/store.test.mjs test/host-smoke.mjs",
    "verify": "node scripts/verify-package.mjs",
    "check": "npm run test && npm run verify",
    "prepublishOnly": "npm run check"
  }
}
